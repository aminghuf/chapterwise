# Copy to .env and fill in. Never commit .env.

# DeepSeek (any OpenAI-compatible API works: change the base URL and model)
DEEPSEEK_API_KEY=
CHAPTERWISE_BASE_URL=https://api.deepseek.com
CHAPTERWISE_MODEL=deepseek-flash

# Where summaries are cached so the same request never hits the API twice
CHAPTERWISE_CACHE_DIR=.cache/chapterwise

# Sections longer than this (approx. tokens) are summarized in parts, then merged
CHAPTERWISE_MAX_CHUNK_TOKENS=24000

# --- Service (web UI + worker) ------------------------------------------------
DATABASE_URL=postgresql+psycopg://chapterwise:chapterwise@localhost:5432/chapterwise
CHAPTERWISE_BOOKS_DIR=./books
CHAPTERWISE_SECRET_KEY=change-me-to-a-long-random-string
CHAPTERWISE_ADMIN_PASSWORD=change-me
CHAPTERWISE_PUBLIC_URL=http://localhost:8100
# Seconds between automatic scans of the books folder
CHAPTERWISE_SCAN_INTERVAL=600
